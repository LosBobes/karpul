# Production environment for the Hetzner deploy (docker-compose.prod.yml).
#
# Copy to `.env` on the server (next to docker-compose.prod.yml) and fill in
# real values. This file is gitignored on the server; never commit it.

# Same-origin deploy (browser -> Caddy -> FastAPI), so this is just the public
# domain. Only add more origins if you serve the frontend elsewhere.
CORS_ORIGINS=https://www.karpul.dev

# Optional seed for the company-car pool, applied on first start only
# (when the car table is empty). Format: Name|PLATE|passenger seats;...
# CORPORATE_CARS=Skoda Octavia|BG-123-XY|4;VW Transporter|BG-456-ZZ|8
CORPORATE_CARS=

# Admins. An admin manages the company-car pool and the accounts (making
# someone else an admin, handing out a password reset link). These usernames
# are admins whatever the app says, which is how the first admin comes to be:
# register in the app, put your username here, restart. More admins can then
# be made from the app's *People* screen. Comma-separated.
KARPUL_ADMINS=

# Only answer from these countries (ISO codes, comma-separated, e.g. DE,RS).
# Empty lets every country in. Looked up in DB-IP Lite (app/geofence.py).
KARPUL_ALLOWED_COUNTRIES=

# Push notifications. The private key signs every push (VAPID); browsers
# subscribe against its public half, so generate it once and keep it:
#   docker compose -f docker-compose.prod.yml run --rm app python -m app.vapid
# Left empty, the deploy workflow generates one into this file on its next run.
# The subject is the contact the push services see (mailto: or https: URL).
KARPUL_VAPID_PRIVATE_KEY=
KARPUL_VAPID_SUBJECT=https://www.karpul.dev

# Optional error tracking: a Sentry DSN. Empty sends nothing anywhere.
KARPUL_SENTRY_DSN=

# Who has the maps for pickup points and places: everyone, admins (to try
# something out first), or off. The pins are kept either way.
KARPUL_MAPS=everyone

# Nightly database snapshots, written by the app itself into its volume and
# rotated (docs/deployment-hetzner.md, "Nightly backups"). Copy them off the
# box too: `make backups`, or the cron line in the runbook.
KARPUL_BACKUP_DIR=/data/backups
KARPUL_BACKUP_KEEP=14
